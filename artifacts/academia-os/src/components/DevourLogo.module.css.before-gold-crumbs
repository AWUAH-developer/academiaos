.stage {
  --devour-academia: #171a3b;
  --devour-os: #f4c542;
  --devour-yellow: #f4c542;
  --devour-surface: #ffffff;

  position: relative;
  display: inline-block;
  width: 8.25em;
  height: 1.22em;
  overflow: hidden;
  vertical-align: middle;
  white-space: nowrap;
  line-height: 1;
}

.word {
  position: absolute;
  top: 50%;
  left: 1.04em;
  display: inline-flex;
  align-items: baseline;
  line-height: 1;
  letter-spacing: -0.045em;
  transform: translateY(-50%);
}

.letter {
  display: inline-block;
  flex: 0 0 auto;
  transition: opacity 55ms linear;
}

.academiaLetter {
  color: var(--devour-academia);
}

.osLetter {
  color: var(--devour-os);
}

.eater {
  position: absolute;
  top: 50%;
  left: 0;
  z-index: 2;
  display: block;
  width: 0.84em;
  height: 0.84em;
  border-radius: 50%;
  background: var(--devour-yellow);
  box-shadow: 0 2px 5px rgb(0 0 0 / 18%);
  transition: transform 150ms linear;
  will-change: transform;
}

.eater::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -1px;
  width: 58%;
  height: 58%;
  background: var(--devour-surface);
  clip-path: polygon(100% 0, 0 50%, 100% 100%);
  transform: translateY(-50%) scaleX(0);
  transform-origin: right center;
}

.holding .eater {
  transition: none;
}

.holding .eater::after {
  transform: translateY(-50%) scaleX(0);
}

.eating .eater::after {
  animation: devourMouth 150ms steps(2, end) infinite;
}

.resetting .letter {
  opacity: 1 !important;
  transition: none;
}

@keyframes devourMouth {
  0%,
  100% {
    transform: translateY(-50%) scaleX(0.94);
  }

  50% {
    transform: translateY(-50%) scaleX(0.15);
  }
}
