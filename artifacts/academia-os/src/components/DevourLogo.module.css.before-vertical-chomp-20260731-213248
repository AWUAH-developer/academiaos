.root {
  display: inline-flex;
  line-height: 1;
  --brand-ink: #1e2550;
  --brand-accent: #f4be10;
}

.dark {
  --brand-ink: #1e2550;
  --brand-accent: #f4be10;
}

.light {
  --brand-ink: #fff8ea;
  --brand-accent: #f4be10;
}

.track {
  position: relative;
  display: inline-block;
  padding-left: 0.78em;
  padding-bottom: 1.05em;
  overflow: visible;
}

.wordmark {
  display: inline-flex;
  align-items: flex-end;
  gap: 0.005em;
  white-space: nowrap;
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  font-size: 1em;
  font-weight: 900;
  letter-spacing: -0.065em;
  line-height: 0.95;
}

.letter {
  display: inline-block;
  transition:
    opacity 110ms linear,
    transform 110ms linear;
  will-change: opacity, transform;
}

.ink {
  color: var(--brand-ink);
}

.accent {
  color: var(--brand-accent);
}

.visible {
  opacity: 1;
  transform: translateY(var(--letter-shift, 0));
}

.hidden {
  opacity: 0;
  transform: translateY(calc(var(--letter-shift, 0) + 0.16em)) scale(0.98);
}

.eaterWrap {
  position: absolute;
  left: 0;
  top: 0.08em;
  z-index: 2;
  width: 0.74em;
  height: 0.74em;
  transform: translate3d(
    var(--travel-x, 0em),
    var(--travel-y, 0em),
    0
  );
  transition: transform 165ms linear;
  will-change: transform;
}

.root[data-phase='return'] .eaterWrap {
  transition: none;
}

.root[data-phase='hold'] .eaterWrap {
  transition-duration: 320ms;
  transition-timing-function: ease-in-out;
}

.eaterFacing {
  display: block;
  width: 100%;
  height: 100%;
  transform: scaleX(1);
  transform-origin: center;
  transition: transform 180ms ease-in-out;
}

.facingLeft {
  transform: scaleX(-1);
}

.eater {
  position: relative;
  width: 0.74em;
  height: 0.74em;
  filter: drop-shadow(0 0.03em 0.06em rgba(0, 0, 0, 0.08));
  animation: eaterBob 320ms linear infinite;
}

.eaterUpper,
.eaterLower {
  position: absolute;
  left: 0;
  width: 100%;
  height: 50%;
  background: var(--brand-accent);
}

.eaterUpper {
  top: 0;
  border-radius: 999px 999px 0 0;
  transform-origin: 100% 100%;
  animation: upperChomp 320ms linear infinite;
}

.eaterLower {
  bottom: 0;
  border-radius: 0 0 999px 999px;
  transform-origin: 100% 0;
  animation: lowerChomp 320ms linear infinite;
}

.eaterEye {
  position: absolute;
  width: 0.08em;
  height: 0.08em;
  border-radius: 999px;
  background: var(--brand-ink);
  left: 0.28em;
  top: 0.18em;
  z-index: 3;
}

.crumbField {
  position: absolute;
  left: 0.56em;
  top: 50%;
  width: 0;
  height: 0;
  pointer-events: none;
}

.crumb {
  position: absolute;
  left: 0;
  top: 0;
  width: var(--crumb-size);
  height: var(--crumb-size);
  border-radius: 999px;
  background: rgba(244, 190, 16, 0.95);
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.8);
  animation: crumbBurst 250ms linear forwards;
  animation-delay: var(--crumb-delay);
}

@keyframes upperChomp {
  0% {
    transform: rotate(0deg);
  }

  20% {
    transform: rotate(-28deg);
  }

  40% {
    transform: rotate(0deg);
  }

  60% {
    transform: rotate(-18deg);
  }

  80% {
    transform: rotate(-28deg);
  }

  100% {
    transform: rotate(0deg);
  }
}

@keyframes lowerChomp {
  0% {
    transform: rotate(0deg);
  }

  20% {
    transform: rotate(28deg);
  }

  40% {
    transform: rotate(0deg);
  }

  60% {
    transform: rotate(18deg);
  }

  80% {
    transform: rotate(28deg);
  }

  100% {
    transform: rotate(0deg);
  }
}

@keyframes eaterBob {
  0% {
    transform: translateY(0.03em);
  }

  20% {
    transform: translateY(-0.01em);
  }

  40% {
    transform: translateY(0.04em);
  }

  60% {
    transform: translateY(-0.005em);
  }

  80% {
    transform: translateY(0.03em);
  }

  100% {
    transform: translateY(0.04em);
  }
}

@keyframes crumbBurst {
  0% {
    opacity: 0;
    transform: translate(-20%, -50%) scale(0.95);
  }

  18% {
    opacity: 0.9;
  }

  100% {
    opacity: 0;
    transform: translate(
      calc(-50% + var(--crumb-x)),
      calc(-50% + var(--crumb-y))
    ) scale(0.15);
  }
}

@media (prefers-reduced-motion: reduce) {
  .letter {
    opacity: 1 !important;
    transform: translateY(var(--letter-shift, 0)) !important;
    transition: none !important;
  }

  .eaterWrap,
  .crumbField {
    display: none !important;
  }
}

/* Solid Pac-Man body repair */
.root {
  --brand-surface: #ffffff;
}

.light {
  --brand-surface: #2f1d14;
}

.eaterFacing {
  position: relative;
  z-index: 2;
}

.eater {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: visible;
  border-radius: 50%;
  background: var(--brand-accent) !important;
  clip-path: none !important;
  filter: drop-shadow(
    0 0.03em 0.06em rgba(0, 0, 0, 0.12)
  );
  animation: eaterBob 320ms linear infinite !important;
}

/* Mouth cutout. The yellow body remains visible. */
.eater::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -0.02em;
  z-index: 3;
  width: 0;
  height: 0;
  border-top: 0.21em solid transparent;
  border-bottom: 0.21em solid transparent;
  border-right: 0.36em solid var(--brand-surface);
  transform: translateY(-50%) scaleY(0.18);
  transform-origin: right center;
  animation: visiblePacmanMouth 320ms ease-in-out infinite;
}

.eaterUpper,
.eaterLower {
  display: none !important;
}

.eaterEye {
  position: absolute;
  top: 0.16em;
  left: 0.28em;
  z-index: 5;
  display: block;
  width: 0.08em;
  height: 0.08em;
  border-radius: 50%;
  background: var(--brand-ink);
}

/* Constant visible trail while letters are being consumed. */
.root[data-phase='eat'] .eaterWrap::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0.04em;
  z-index: 1;
  width: 0.10em;
  height: 0.10em;
  border-radius: 50%;
  background: var(--brand-accent);
  box-shadow:
    -0.17em -0.15em 0 -0.01em var(--brand-accent),
    -0.29em 0.02em 0 -0.02em var(--brand-accent),
    -0.39em 0.16em 0 -0.025em var(--brand-accent),
    -0.50em -0.08em 0 -0.035em var(--brand-accent);
  transform: translateY(-50%);
  animation: visiblePacmanTrail 360ms ease-out infinite;
}

/* Existing React particles, made larger and longer-lasting. */
.crumbField {
  top: 50%;
  left: 0.05em;
  z-index: 1;
}

.crumb {
  background: var(--brand-accent);
  opacity: 0;
  animation: visibleCrumbScatter 440ms ease-out forwards !important;
  animation-delay: var(--crumb-delay) !important;
}

@keyframes visiblePacmanMouth {
  0%,
  100% {
    transform: translateY(-50%) scaleY(0.16);
  }

  50% {
    transform: translateY(-50%) scaleY(1);
  }
}

@keyframes visiblePacmanTrail {
  0% {
    opacity: 1;
    transform: translate(0, -50%) scale(1);
  }

  100% {
    opacity: 0;
    transform: translate(-0.32em, -50%) scale(0.35);
  }
}

@keyframes visibleCrumbScatter {
  0% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.4);
  }

  100% {
    opacity: 0;
    transform:
      translate(
        calc(-50% + var(--crumb-x)),
        calc(-50% + var(--crumb-y))
      )
      scale(0.2);
  }
}

/* Final Pac-Man visibility override */
.eaterWrap {
  z-index: 20 !important;
  width: 0.92em !important;
  height: 0.92em !important;
}

.eaterFacing {
  width: 100% !important;
  height: 100% !important;
}

.eater {
  position: relative;
  width: 100% !important;
  height: 100% !important;
  overflow: hidden !important;
  border-radius: 50% !important;
  background: #ffcc00 !important;
  clip-path: none !important;
  opacity: 1 !important;
  visibility: visible !important;
}

/* Visible animated mouth cut from the solid body */
.eater::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -1px;
  z-index: 4;
  width: 58%;
  height: 58%;
  background: var(--brand-surface, #ffffff);
  clip-path: polygon(100% 0, 0 50%, 100% 100%);
  transform: translateY(-50%) scaleX(0.18);
  transform-origin: right center;
  animation: finalPacmanMouth 320ms steps(2, end) infinite;
}

.eaterEye {
  top: 0.20em !important;
  left: 0.35em !important;
  z-index: 6 !important;
  width: 0.09em !important;
  height: 0.09em !important;
  background: #1e2550 !important;
}

/* Strong visible crumbs behind Pac-Man */
.root[data-phase='eat'] .eaterWrap::before {
  content: '';
  position: absolute;
  top: 50%;
  left: -0.08em;
  z-index: -1;
  width: 0.12em;
  height: 0.12em;
  border-radius: 50%;
  background: #ffcc00;
  box-shadow:
    -0.18em -0.16em 0 -0.01em #ffcc00,
    -0.34em 0.03em 0 -0.02em #ffcc00,
    -0.48em 0.18em 0 -0.025em #ffcc00,
    -0.62em -0.09em 0 -0.035em #ffcc00;
  transform: translateY(-50%);
  animation: finalPacmanTrail 420ms ease-out infinite;
}

.crumbField {
  left: -0.04em !important;
  z-index: 1 !important;
}

.crumb {
  width: 0.11em !important;
  height: 0.11em !important;
  background: #ffcc00 !important;
  animation-duration: 520ms !important;
}

@keyframes finalPacmanMouth {
  0%,
  100% {
    transform: translateY(-50%) scaleX(0.18);
  }

  50% {
    transform: translateY(-50%) scaleX(1);
  }
}

@keyframes finalPacmanTrail {
  0% {
    opacity: 1;
    transform: translate(0, -50%) scale(1);
  }

  100% {
    opacity: 0;
    transform: translate(-0.38em, -50%) scale(0.25);
  }
}


/* Guaranteed-visible SVG Pac-Man */
.root {
  --brand-surface: #ffffff;
}

.light {
  --brand-surface: #2f1d14;
}

.pacmanSvg {
  position: relative;
  z-index: 5;
  display: block !important;
  width: 100% !important;
  height: 100% !important;
  overflow: visible !important;
  opacity: 1 !important;
  visibility: visible !important;
  filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.14));
}

.pacmanBody {
  fill: #ffcc00 !important;
  opacity: 1 !important;
}

.pacmanMouth {
  fill: var(--brand-surface, #ffffff) !important;
  transform-box: fill-box;
  transform-origin: right center;
  animation: svgPacmanChomp 320ms ease-in-out infinite;
}

.pacmanEyeSvg {
  fill: #1e2550 !important;
}

.root[data-phase='eat'] .eaterWrap::before {
  z-index: 2 !important;
  opacity: 1 !important;
}

.crumbField {
  z-index: 3 !important;
}

.crumb {
  opacity: 1;
  background: #ffcc00 !important;
}

@keyframes svgPacmanChomp {
  0%,
  100% {
    transform: scaleY(0.22);
  }

  50% {
    transform: scaleY(1);
  }
}
