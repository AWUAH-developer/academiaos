'use client';

import type { CSSProperties } from 'react';
import { useEffect, useState } from 'react';
import styles from './DevourLogo.module.css';

const LETTERS = [
  { char: 'A', accent: false },
  { char: 'c', accent: false },
  { char: 'a', accent: false },
  { char: 'd', accent: false },
  { char: 'e', accent: false },
  { char: 'm', accent: false },
  { char: 'i', accent: false },
  { char: 'a', accent: false },
  { char: 'O', accent: true },
  { char: 'S', accent: true },
] as const;

const CRUMBS = [
  { x: '-0.18em', y: '-0.24em', size: '0.10em', delay: '0ms' },
  { x: '-0.28em', y: '-0.08em', size: '0.08em', delay: '35ms' },
  { x: '-0.22em', y: '0.08em', size: '0.09em', delay: '70ms' },
  { x: '-0.34em', y: '0.22em', size: '0.07em', delay: '105ms' },
  { x: '-0.42em', y: '-0.16em', size: '0.06em', delay: '140ms' },
] as const;

const HOLD_TIME = 900;
const EAT_STEP_TIME = 170;
const EMPTY_PAUSE_TIME = 240;
const REBUILD_STEP_TIME = 110;
const REBUILD_PAUSE_TIME = 220;
const RETURN_TIME = 560;

type AnimationPhase = 'hold' | 'eat' | 'rebuild' | 'return';

type DevourLogoProps = {
  className?: string;
  variant?: 'dark' | 'light';
};

function useReducedMotion() {
  const [reducedMotion, setReducedMotion] = useState(false);

  useEffect(() => {
    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const update = () => setReducedMotion(mediaQuery.matches);

    update();
    mediaQuery.addEventListener('change', update);

    return () => {
      mediaQuery.removeEventListener('change', update);
    };
  }, []);

  return reducedMotion;
}

export function DevourLogo({
  className = '',
  variant = 'dark',
}: DevourLogoProps) {
  const reducedMotion = useReducedMotion();

  const [phase, setPhase] = useState<AnimationPhase>('hold');
  const [eatenCount, setEatenCount] = useState(0);
  const [rebuiltCount, setRebuiltCount] = useState(0);
  const [returnProgress, setReturnProgress] = useState(0);
  const [crumbBurstKey, setCrumbBurstKey] = useState(0);

  useEffect(() => {
    if (!reducedMotion) return;

    setPhase('hold');
    setEatenCount(0);
    setRebuiltCount(0);
    setReturnProgress(0);
  }, [reducedMotion]);

  useEffect(() => {
    if (reducedMotion) return;

    let timeoutId: number | undefined;
    let frameId = 0;

    if (phase === 'hold') {
      timeoutId = window.setTimeout(() => {
        setEatenCount(0);
        setRebuiltCount(0);
        setReturnProgress(0);
        setPhase('eat');
      }, HOLD_TIME);
    }

    if (phase === 'eat') {
      if (eatenCount < LETTERS.length) {
        timeoutId = window.setTimeout(() => {
          setEatenCount((value) => value + 1);
          setCrumbBurstKey((value) => value + 1);
        }, EAT_STEP_TIME);
      } else {
        timeoutId = window.setTimeout(() => {
          setRebuiltCount(0);
          setPhase('rebuild');
        }, EMPTY_PAUSE_TIME);
      }
    }

    if (phase === 'rebuild') {
      if (rebuiltCount < LETTERS.length) {
        timeoutId = window.setTimeout(() => {
          setRebuiltCount((value) => value + 1);
        }, REBUILD_STEP_TIME);
      } else {
        timeoutId = window.setTimeout(() => {
          setReturnProgress(0);
          setPhase('return');
        }, REBUILD_PAUSE_TIME);
      }
    }

    if (phase === 'return') {
      const startedAt = performance.now();

      const tick = (now: number) => {
        const progress = Math.min((now - startedAt) / RETURN_TIME, 1);
        setReturnProgress(progress);

        if (progress < 1) {
          frameId = window.requestAnimationFrame(tick);
          return;
        }

        setPhase('hold');
        setEatenCount(0);
        setRebuiltCount(0);
        setReturnProgress(0);
      };

      frameId = window.requestAnimationFrame(tick);
    }

    return () => {
      if (timeoutId) window.clearTimeout(timeoutId);
      if (frameId) window.cancelAnimationFrame(frameId);
    };
  }, [phase, eatenCount, rebuiltCount, reducedMotion]);

  const travelProgress = reducedMotion
    ? 0
    : phase === 'eat'
      ? eatenCount / LETTERS.length
      : phase === 'rebuild'
        ? 1
        : phase === 'return'
          ? 1 - returnProgress
          : 0;

  const rootClassName = [
    styles.root,
    variant === 'light' ? styles.light : styles.dark,
    className,
  ]
    .filter(Boolean)
    .join(' ');

  return (
    <span className={rootClassName} data-phase={phase}>
      <span className={styles.track}>
        <span className={styles.wordmark} aria-label="AcademiaOS">
          {LETTERS.map((letter, index) => {
            const visible =
              reducedMotion ||
              phase === 'hold' ||
              phase === 'return'
                ? true
                : phase === 'eat'
                  ? index >= eatenCount
                  : index < rebuiltCount;

            return (
              <span
                key={`${letter.char}-${index}`}
                className={[
                  styles.letter,
                  letter.accent ? styles.accent : styles.ink,
                  visible ? styles.visible : styles.hidden,
                ].join(' ')}
              >
                {letter.char}
              </span>
            );
          })}
        </span>

        {!reducedMotion && (
          <span
            className={styles.eaterWrap}
            style={
              {
                '--travel-progress': String(travelProgress),
              } as CSSProperties
            }
            aria-hidden="true"
          >
            <span className={styles.eater}>
              <span className={styles.eaterUpper} />
              <span className={styles.eaterLower} />
              <span className={styles.eaterEye} />
            </span>

            {phase === 'eat' && (
              <span className={styles.crumbField} key={crumbBurstKey}>
                {CRUMBS.map((crumb, index) => (
                  <span
                    key={index}
                    className={styles.crumb}
                    style={
                      {
                        '--crumb-x': crumb.x,
                        '--crumb-y': crumb.y,
                        '--crumb-size': crumb.size,
                        '--crumb-delay': crumb.delay,
                      } as CSSProperties
                    }
                  />
                ))}
              </span>
            )}
          </span>
        )}
      </span>
    </span>
  );
}

export default DevourLogo;
