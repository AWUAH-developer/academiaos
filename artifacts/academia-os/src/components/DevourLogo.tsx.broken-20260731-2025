'use client';

import type { CSSProperties } from 'react';
import { useEffect, useState } from 'react';

import styles from './DevourLogo.module.css';

const LETTERS = [
  { char: 'A', accent: false, shift: '0em' },
  { char: 'c', accent: false, shift: '0em' },
  { char: 'a', accent: false, shift: '0em' },
  { char: 'd', accent: false, shift: '0.03em' },
  { char: 'e', accent: false, shift: '-0.02em' },
  { char: 'm', accent: false, shift: '-0.02em' },
  { char: 'i', accent: false, shift: '0.03em' },
  { char: 'a', accent: false, shift: '-0.02em' },
  { char: 'O', accent: true, shift: '0.03em' },
  { char: 'S', accent: true, shift: '0.03em' },
] as const;

const CRUMBS = [
  { x: '-0.18em', y: '-0.24em', size: '0.10em', delay: '0ms' },
  { x: '-0.28em', y: '-0.08em', size: '0.08em', delay: '35ms' },
  { x: '-0.22em', y: '0.08em', size: '0.09em', delay: '70ms' },
  { x: '-0.34em', y: '0.22em', size: '0.07em', delay: '105ms' },
  { x: '-0.42em', y: '-0.16em', size: '0.06em', delay: '140ms' },
] as const;

const HOLD_TIME = 1200;
const EAT_STEP_TIME = 165;
const EMPTY_PAUSE_TIME = 220;
const TURN_TIME = 320;
const RETURN_TIME = 1400;
const RISE_TIME = 320;
const TRAVEL_DISTANCE_EM = 7.15;

type AnimationPhase =
  | 'hold'
  | 'eat'
  | 'turn'
  | 'return'
  | 'rise';

type DevourLogoProps = {
  className?: string;
  variant?: 'dark' | 'light';
};

function useReducedMotion() {
  const [reducedMotion, setReducedMotion] = useState(false);

  useEffect(() => {
    const mediaQuery = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    );

    const update = () => {
      setReducedMotion(mediaQuery.matches);
    };

    update();
    mediaQuery.addEventListener('change', update);

    return () => {
      mediaQuery.removeEventListener('change', update);
    };
  }, []);

  return reducedMotion;
}

export function DevourLogo({
  className = '',
  variant = 'dark',
}: DevourLogoProps) {
  const reducedMotion = useReducedMotion();

  const [phase, setPhase] =
    useState<AnimationPhase>('hold');
  const [eatenCount, setEatenCount] = useState(0);
  const [returnProgress, setReturnProgress] = useState(0);
  const [crumbBurstKey, setCrumbBurstKey] = useState(0);

  useEffect(() => {
    if (!reducedMotion) return;

    setPhase('hold');
    setEatenCount(0);
    setReturnProgress(0);
  }, [reducedMotion]);

  useEffect(() => {
    if (reducedMotion) return;

    let timeoutId: number | undefined;
    let frameId = 0;

    if (phase === 'hold') {
      timeoutId = window.setTimeout(() => {
        setEatenCount(0);
        setReturnProgress(0);
        setPhase('eat');
      }, HOLD_TIME);
    }

    if (phase === 'eat') {
      if (eatenCount < LETTERS.length) {
        timeoutId = window.setTimeout(() => {
          setEatenCount((value) => value + 1);
          setCrumbBurstKey((value) => value + 1);
        }, EAT_STEP_TIME);
      } else {
        timeoutId = window.setTimeout(() => {
          setPhase('turn');
        }, EMPTY_PAUSE_TIME);
      }
    }

    if (phase === 'turn') {
      timeoutId = window.setTimeout(() => {
        setReturnProgress(0);
        setPhase('return');
      }, TURN_TIME);
    }

    if (phase === 'return') {
      const startedAt = performance.now();

      const tick = (now: number) => {
        const progress = Math.min(
          (now - startedAt) / RETURN_TIME,
          1,
        );

        setReturnProgress(progress);

        if (progress < 1) {
          frameId = window.requestAnimationFrame(tick);
          return;
        }

        setPhase('rise');
      };

      frameId = window.requestAnimationFrame(tick);
    }

    if (phase === 'rise') {
      timeoutId = window.setTimeout(() => {
        setEatenCount(0);
        setReturnProgress(0);
        setPhase('hold');
      }, RISE_TIME);
    }

    return () => {
      if (timeoutId) {
        window.clearTimeout(timeoutId);
      }

      if (frameId) {
        window.cancelAnimationFrame(frameId);
      }
    };
  }, [phase, eatenCount, reducedMotion]);

  const travelProgress =
    phase === 'eat'
      ? Math.min(eatenCount / LETTERS.length, 1)
      : phase === 'turn'
        ? 1
        : phase === 'return'
          ? 1 - returnProgress
          : 0;

  const travelX = `${
    travelProgress * TRAVEL_DISTANCE_EM
  }em`;

  const travelY =
    phase === 'turn' || phase === 'return'
      ? '0.95em'
      : '0em';

  const facingLeft =
    phase === 'turn' || phase === 'return';

  const rebuiltCount =
    phase === 'return'
      ? Math.min(
          LETTERS.length,
          Math.ceil(returnProgress * LETTERS.length),
        )
      : 0;

  const rootClassName = [
    styles.root,
    variant === 'light' ? styles.light : styles.dark,
    className,
  ]
    .filter(Boolean)
    .join(' ');

  return (
    <span
      className={rootClassName}
      data-phase={phase}
      role="img"
      aria-label="AcademiaOS"
    >
      <span className={styles.track}>
        <span className={styles.wordmark} aria-hidden="true">
          {LETTERS.map((letter, index) => {
            let visible = true;

            if (!reducedMotion) {
              if (phase === 'eat') {
                visible = index >= eatenCount;
              }

              if (phase === 'turn') {
                visible = false;
              }

              if (phase === 'return') {
                visible = index < rebuiltCount;
              }
            }

            return (
              <span
                key={`${letter.char}-${index}`}
                className={[
                  styles.letter,
                  letter.accent
                    ? styles.accent
                    : styles.ink,
                  visible
                    ? styles.visible
                    : styles.hidden,
                ].join(' ')}
                style={
                  {
                    '--letter-shift': letter.shift,
                  } as CSSProperties
                }
              >
                {letter.char}
              </span>
            );
          })}
        </span>

        {!reducedMotion && (
          <span
            className={styles.eaterWrap}
            style={
              {
                '--travel-x': travelX,
                '--travel-y': travelY,
              } as CSSProperties
            }
            aria-hidden="true"
          >
            <span
              className={[
                styles.eaterFacing,
                facingLeft ? styles.facingLeft : '',
              ]
                .filter(Boolean)
                .join(' ')}
            >
              <span className={styles.eater}>
                <span className={styles.eaterUpper} />
                <span className={styles.eaterLower} />
                <span className={styles.eaterEye} />
              </span>
            </span>

            {phase === 'eat' && (
              <span
                className={styles.crumbField}
                key={crumbBurstKey}
              >
                {CRUMBS.map((crumb, index) => (
                  <span
                    key={index}
                    className={styles.crumb}
                    style={
                      {
                        '--crumb-x': crumb.x,
                        '--crumb-y': crumb.y,
                        '--crumb-size': crumb.size,
                        '--crumb-delay': crumb.delay,
                      } as CSSProperties
                    }
                  />
                ))}
              </span>
            )}
          </span>
        )}
      </span>
    </span>
  );
}

export default DevourLogo;
