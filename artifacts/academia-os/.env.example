# PostgreSQL. Add these through Replit Secrets and Published App Secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
DATABASE_SSL="false"
DATABASE_SSL_REJECT_UNAUTHORIZED="true"
DATABASE_POOL_MAX="10"

# Authentication. The __Host- prefix is recommended for the public HTTPS deployment.
SESSION_COOKIE_NAME="__Host-academiaos_session"
NEXT_PUBLIC_APP_NAME="AcademiaOS"
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS="false"
NEXT_TELEMETRY_DISABLED="1"

# One-time production bootstrap. Add these as Secrets, run npm run db:bootstrap-admin once,
# then delete INITIAL_SUPER_ADMIN_PASSWORD from Secrets.
INITIAL_SUPER_ADMIN_NAME=""
INITIAL_SUPER_ADMIN_USERNAME=""
INITIAL_SUPER_ADMIN_EMAIL=""
INITIAL_SUPER_ADMIN_PHONE=""
INITIAL_SUPER_ADMIN_PASSWORD=""

# SMS provider. Set SMS_PROVIDER=TWILIO to enable the built-in Twilio adapter.
SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# WhatsApp provider. Set WHATSAPP_PROVIDER=META_CLOUD to enable WhatsApp Cloud API.
WHATSAPP_PROVIDER=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Generic provider fallback for SMS, WhatsApp, or email.
MESSAGE_WEBHOOK_URL=""
MESSAGE_WEBHOOK_KEY=""

# Authentication mode. AcademiaOS uses its own database username/password login.
# Set true only for an isolated demonstration deployment. Remove it before real public use.
ACADEMIAOS_DEMO_MODE="false"
