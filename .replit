modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ACADEMIAOS_DEMO_MODE = "true"
NEXT_PUBLIC_APP_NAME = "AcademiaOS"
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS = "true"
NEXT_TELEMETRY_DISABLED = "1"
